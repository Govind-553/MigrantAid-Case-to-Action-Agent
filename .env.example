# LLM Settings
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash

# Database Settings (PostgreSQL)
DATABASE_URL=your_postgres_connection_string
DIRECT_URL=your_postgres_direct_connection_string

# Application Environment
APP_ENV=development

# --- Deployment settings (Vercel / Render) ---

# Local dev: http://127.0.0.1:8000 (default). Production: https://<your-render-backend>.onrender.com
BACKEND_URL=http://127.0.0.1:8000

# Local dev: http://localhost:3000 (default). Production: https://<your-vercel-frontend>.vercel.app
FRONTEND_URL=http://localhost:3000

